    {"rule": "(?:^|/)(?:Session [1-6]|Autres cours)/[^/]+/Classe/Colab$", "icon": "LiCloud", "for": "folders", "useFilePath": true},
    {"rule": "(?:^|/)(?:Session [1-6]|Autres cours)/[^/]+/Classe/NumPy & Keras$", "icon": "LiBrainCircuit", "for": "folders", "useFilePath": true},
    {"rule": "(?:^|/)(?:Session [1-6]|Autres cours)/[^/]+/Classe/Google Cloud$", "icon": "LiCloudCog", "for": "folders", "useFilePath": true},
