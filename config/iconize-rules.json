{
  "schema": 1,
  "plugin_id": "obsidian-icon-folder",
  "note": "Canonical CEM folder rules. cem_importer.py iconize merges these into Iconize and preserves icons already chosen for matching rules.",
  "rules": [
    {"rule": "(?:^|/)Session [1-6]$", "icon": "LiLayers3", "for": "folders", "useFilePath": true},
    {"rule": "(?:^|/)Autres cours$", "icon": "LiFolderOpen", "for": "folders", "useFilePath": true},
    {"rule": "(?:^|/)(?:Session [1-6]|Autres cours)/[^/]+/Classe$", "icon": "LiLibraryBig", "for": "folders", "useFilePath": true},
    {"rule": "(?:^|/)(?:Session [1-6]|Autres cours)/[^/]+/Classe/Cours$", "icon": "LiBookOpen", "for": "folders", "useFilePath": true},
    {"rule": "(?:^|/)(?:Session [1-6]|Autres cours)/[^/]+/Classe/TP$", "icon": "LiClipboardCheck", "for": "folders", "useFilePath": true},
